---
import EditorialSection from './EditorialSection.astro';
const {label,title,description,pending,href,linkText}=Astro.props;
---
<EditorialSection label={label} title={title} description={description}><div class="feature-panel"><span class="feature-mark" aria-hidden="true">↗</span><p>{pending}</p><a class="text-link" href={href}>{linkText} ↗</a></div></EditorialSection>
<style>.feature-panel{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:2.5rem 0;margin-top:2.5rem}.feature-mark{font-size:3rem;color:#a2b5c4}.feature-panel p{color:var(--slate);flex:1;min-width:200px}</style>
