---
import { home } from '../../i18n/home.js';
interface Props { t: typeof home.en; lang?: 'th' | 'en' }
const { t, lang } = Astro.props;
const url=(s: string)=>`/${lang}/${s}`;
---
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">{t.kicker}</p><h1>{t.heroTitle}</h1><p class="hero-lead">{t.heroDesc}</p><div class="hero-actions"><a class="button primary" href={url('work/')}>{lang==='th'?'สำรวจผลงาน':'Explore My Work'} <span aria-hidden="true">↗</span></a><a class="button" href={url('contact/')}>{t.connectLink}</a></div><div class="hero-bottom"><span>CHAINUWAT</span><span>INTEGRATED MANAGEMENT & TRANSFORMATION</span></div></div><div class="portrait" aria-label={t.portrait} role="img"><div class="portrait-art" aria-hidden="true"><span class="portrait-initial">C.</span><span class="portrait-line"></span></div><p>{t.portrait}</p></div></div></section>
<style>
.hero{background:#f0f4f7;border-bottom:1px solid var(--border)}.hero-grid{display:grid;grid-template-columns:minmax(0,3fr) minmax(260px,2fr);min-height:660px;gap:clamp(2rem,6vw,6rem)}.hero-copy{display:flex;flex-direction:column;align-items:start;justify-content:center;padding-block:5rem 2rem}.hero h1{font-size:clamp(3.3rem,6.7vw,6.5rem);line-height:1.09;letter-spacing:-.068em;max-width:820px;margin:1.2rem 0 1.8rem}.hero-lead{font-size:clamp(1.1rem,1.7vw,1.35rem);line-height:1.65;max-width:550px;color:var(--slate);margin:0}.hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2.2rem}.hero-actions .button{gap:1.5rem}.hero-bottom{display:flex;justify-content:space-between;gap:1rem;width:100%;font-size:.64rem;letter-spacing:.12em;font-weight:800;margin-top:auto;padding-top:5rem;color:#718095}.portrait{background:linear-gradient(145deg,#d7e3ec,#8ea8be);min-height:570px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-block:2.5rem}.portrait-art{position:absolute;inset:10%;border:1px solid rgba(255,255,255,.45);display:flex;align-items:center;justify-content:center}.portrait-initial{font-size:clamp(7rem,16vw,15rem);font-weight:700;letter-spacing:-.12em;color:rgba(20,45,78,.15)}.portrait-line{position:absolute;left:-20%;right:-20%;top:62%;height:1px;background:rgba(255,255,255,.5);transform:rotate(-28deg)}.portrait p{position:absolute;bottom:1.4rem;left:1.4rem;right:1.4rem;text-align:center;color:#142d4e;font-size:.75rem;font-weight:700;letter-spacing:.04em}@media(max-width:767px){.hero-grid{grid-template-columns:1fr;gap:0}.hero-copy{padding-block:4rem 2rem}.hero h1{font-size:clamp(2.8rem,12vw,4.5rem)}.hero-bottom{padding-top:3rem;flex-wrap:wrap}.portrait{min-height:320px;margin:0 0 2rem}.portrait-initial{font-size:9rem}}
</style>
