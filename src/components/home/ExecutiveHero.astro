---
import { home } from '../../i18n/home.js';

interface Props {
  t: typeof home.en;
  lang?: 'th' | 'en';
}

const { t, lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (s: string) => `${base}${lang}/${s}`;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t.kicker}</p>
      <h1>{t.heroTitle}</h1>
      <p class="hero-lead">{t.heroDesc}</p>

      <div class="hero-actions">
        <a class="button primary" href={url('work/')}>
          {lang === 'th' ? 'สำรวจผลงาน' : 'Explore My Work'}
          <span aria-hidden="true">↗</span>
        </a>

        <a class="button" href={url('contact/')}>
          {t.connectLink}
        </a>
      </div>

      <div class="hero-bottom">
        <span>CHAINUWAT</span>
        <span>INTEGRATED MANAGEMENT & TRANSFORMATION</span>
      </div>
    </div>

    <div class="portrait">
      <img
        src={`${base}images/profile.jpg`}
        alt={lang === 'th'
          ? 'ภาพโปรไฟล์ของชัยนุวัตร ช่วยคงทอง'
          : 'Portrait of Chainuwat'}
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background: #f0f4f7;
    border-bottom: 1px solid var(--border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(260px, 2fr);
    min-height: 660px;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    padding-block: 5rem 2rem;
  }

  .hero h1 {
    font-size: clamp(3.3rem, 6.7vw, 6.5rem);
    line-height: 1.09;
    letter-spacing: -.068em;
    max-width: 820px;
    margin: 1.2rem 0 1.8rem;
  }

  .hero-lead {
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.65;
    max-width: 550px;
    color: var(--slate);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    margin-top: 2.2rem;
  }

  .hero-actions .button {
    gap: 1.5rem;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    font-size: .64rem;
    letter-spacing: .12em;
    font-weight: 800;
    margin-top: auto;
    padding-top: 5rem;
    color: #718095;
  }

  .portrait {
    position: relative;
    min-height: 570px;
    margin-block: 2.5rem;
    overflow: hidden;
    background: #d7e3ec;
  }

  .portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 47% center;
  }

  @media (max-width: 767px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hero-copy {
      padding-block: 4rem 2rem;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 12vw, 4.5rem);
    }

    .hero-bottom {
      padding-top: 3rem;
      flex-wrap: wrap;
    }

    .portrait {
      min-height: 320px;
      margin: 0 0 2rem;
    }
  }
</style>
