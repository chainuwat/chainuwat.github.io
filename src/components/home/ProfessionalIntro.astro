---
import { home } from '../../i18n/home.js';
interface Props { t: typeof home.en; lang?: 'th' | 'en' }
import EditorialSection from './EditorialSection.astro';
const {t,lang}=Astro.props;
---
<EditorialSection label={t.introLabel} title={t.introTitle} id="introduction"><div class="intro-grid"><div class="prose"><p>{t.intro1}</p><p>{t.intro2}</p><p>{t.approach}</p><a class="text-link" href={`/${lang}/about/`}>{t.aboutLink} ↗</a></div><aside aria-label={lang==='th'?'ขอบเขตประสบการณ์':'Areas of responsibility'}><p class="aside-label">{lang==='th'?'ขอบเขตงานและความสนใจ':'RESPONSIBILITIES & EXPLORATION'}</p>{t.evidence.map((e,i)=><div class="evidence"><span>0{i+1}</span><strong>{e}</strong></div>)}</aside></div></EditorialSection>
<style>.intro-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(250px,1fr);gap:clamp(2rem,7vw,7rem);margin-top:2rem}.prose{max-width:740px;color:var(--slate);font-size:1.05rem}.prose p{margin:0 0 1.3rem}.prose .text-link{display:inline-block;margin-top:.5rem;color:var(--navy)}aside{border-top:2px solid var(--navy);align-self:start}.aside-label{font-size:.7rem;letter-spacing:.1em;font-weight:800;color:var(--blue);margin:1.5rem 0}.evidence{display:flex;gap:1rem;padding:1.2rem 0;border-bottom:1px solid var(--border)}.evidence span{font-size:.72rem;color:var(--blue);font-weight:700}.evidence strong{font-size:.95rem}@media(max-width:767px){.intro-grid{grid-template-columns:1fr}}</style>
